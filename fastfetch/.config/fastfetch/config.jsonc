{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "type": "file",
      "source": "~/.config/fastfetch/logo.txt",
      "padding": {
	"top": 1,
	"left": 1,
	"right": 5 
      },
      "color": {
	"1": "#eceff4"
      }
    },
    "display": { 
      "separator": "  "
    },
    "modules": [ 
      {
	"type": "custom",
	"format": "┌──────────────────────────────────────┐",
	"outputColor": "#4c566a"
      },
      "break",
      {
	"type": "kernel",
	"key": "󰌽",
	"keyColor": "#81a1c1"
      },
      {
	"type": "os",
	"key": "󰣇",
	"keyColor": "#81a1c1"
      },
      {
	"type": "wm",
	"key": "",
	"keyColor": "#81a1c1"
      },
      {
	"type": "lm",
	"key": "",
	"keyColor": "#81a1c1"
      },
      "break",
      {
	"type": "memory",
	"key": "",
	"keyColor": "#81a1c1"
      },
      {
	"type": "disk",
	"key": "",
	"keyColor": "#81a1c1"
      },
      "break",
      {
	"type": "colors",
	"key": "",
	"keyColor": "#81a1c1",
	"padding": 2,
	"symbol": "circle"
      },
      "break",
      {
	"type": "custom",
	"format": "└──────────────────────────────────────┘",
	"outputColor": "#4c566a"
      }
    ]
}
